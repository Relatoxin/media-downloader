{
  "manifest_version": 3,
  "name": "Media Downloader Companion",
  "version": "0.3.4",
  "minimum_chrome_version": "102",
  "description": "Передаёт поддерживаемые страницы и обнаруженные HLS/DASH-потоки локальному Media Downloader.",
  "permissions": ["activeTab", "clipboardWrite", "scripting", "storage", "tabs", "webRequest"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:17843/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Обнаруженные медиапотоки",
    "default_popup": "popup.html"
  }
}
